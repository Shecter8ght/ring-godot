[sub_resource type="Shader" id="grid_shader"]
code = "shader_type spatial;
void fragment() {
 vec2 grid = UV * vec2(200.0, 240.0);
 vec2 edge = abs(fract(grid - 0.5) - 0.5) / max(fwidth(grid), vec2(0.001));
 float line = 1.0 - min(min(edge.x, edge.y), 1.0);
 float checker = mod(floor(grid.x) + floor(grid.y), 2.0);
 ALBEDO = mix(mix(vec3(0.25, 0.29, 0.31), vec3(0.31, 0.35, 0.37), checker), vec3(0.5, 0.54, 0.55), line * 0.5);
 ROUGHNESS = 0.85;
}"

[sub_resource type="ShaderMaterial" id="floor_material"]
shader = SubResource("grid_shader")

