class_name SpawnPoint
extends Marker3D
## Точка появления группы. Уровень выбирает одну случайную на рейд; игроки встают вокруг неё.
## Двигается мышкой в сцене уровня.

@export var display_name: String = ""
## Точка захода группы в рейд с периметра участка (убежище — на другой карте). Есть такие —
## уровень берёт только их; остальные точки остаются для уровней без захода.
@export var entry: bool = false


func _ready() -> void:
	add_to_group("spawn_points")
