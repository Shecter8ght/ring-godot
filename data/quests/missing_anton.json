 "dialogues": {
  "intro": [
   ["Сергей", "Антон не вернулся."],
   ["Сергей", "Четыре дня уже."],
   ["Сергей", "Сказал, что сходит к торговому центру и вернётся к вечеру."],
   ["Сергей", "Он иногда задерживался. Но не настолько."],
   ["Сергей", "Если увидишь хоть что-нибудь — рюкзак, оружие, следы — принеси. Или хотя бы запомни место."]
  ],
  "backpack": [
   ["Сергей", "Это его рюкзак. Я сам ему лямку зашивал."],
   ["Сергей", "Кровь… Но тела не было? Точно?"],
   ["Сергей", "Значит, ушёл. Раненый — но ушёл."],
   ["Сергей", "С парковки он бы не пошёл через главный вход. Через служебку. Через разгрузку."],
   ["Сергей", "Посмотри там. Пожалуйста."]
  ],
  "note": [
   ["Сергей", "«П-3»… Это паркинг. Третий уровень."],
   ["Сергей", "Двадцать один ноль-ноль."],
   ["Сергей", "Зачем ему туда понадобилось, ещё и вечером — не знаю."],
   ["Сергей", "Не знаю, говорю. Сходи и посмотри."]
  ],
  "confession": [
   ["Сергей", "…Да. Я знаю, чьи это пачки."],
   ["Сергей", "Я говорил с ними. С некоторыми из тех, кто там ходит."],
   ["Сергей", "Я не сдавал им людей. Я говорил, где стреляли. Какие районы уже пустые. Где кто-то проходил."],
   ["Сергей", "Слухи. За это они иногда оставляли мне патроны и еду."],
   ["Сергей", "Ты думаешь, мы всё это время откуда это брали? Без этого мы бы прошлый месяц не пережили."],
   ["Сергей", "Антон был против. Сразу, с первого дня."],
   ["Сергей", "Если он пошёл на П-3 сам… Он пошёл это прекратить."],
   ["Сергей", "У него было место, где он прятал своё. Где-то в служебке ТЦ. Найди."]
  ],
  "files": [
   ["Сергей", "Дай посмотреть."],
   ["Сергей", "«Трое. Уходят утром.» Это… это я им говорил. Про тех, с водокачки."],
   ["Сергей", "Я думал, это просто слухи. Кто где ходит."],
   ["Сергей", "Они собирали. Всё. Каждую мелочь."],
   ["Сергей", "…И нас тоже."],
   ["Сергей", "Красные ворота — это грузовой двор. Там стоят их люди."],
   ["Сергей", "Если он там — вытащи его. Что хочешь проси."]
  ],
  "finale": [
   ["Антон", "…Живой. Не благодаря тебе, Серёга."],
   ["Сергей", "Я не давал им нас. Никогда. Ни одной координаты."],
   ["Антон", "Ты давал им всё остальное. Когда мы выходим. Сколько нас. С чем."],
   ["Антон", "Они сложили это за месяц. Им не нужны были координаты."],
   ["Сергей", "Мы бы без этого не выжили. Ты помнишь, что у нас было? Ничего не было."],
   ["Антон", "Ты перестал видеть разницу. Между «продать слух» и «продать человека»."],
   ["Сергей", "Я думал, что держу это под контролем."],
   ["Антон", "Все так думают."],
   ["Сергей", "…Спасибо, что вытащил его. Возьми. Это немного, но — возьми."]
  ]
 },
