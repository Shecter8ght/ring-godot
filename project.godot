; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RING"
config/description="Тактический extraction-шутер от первого лица. Кооп на троих, военная часть 600×600 м."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[autoload]

ReleasePatch="*res://src/core/release_patch.gd"
Balance="*res://src/core/balance.gd"
Settings="*res://src/core/settings.gd"
NoiseBus="*res://src/core/noise_bus.gd"
Audio="*res://src/audio/audio_system.gd"
ImpactFx="*res://src/combat/impact_fx.gd"
Loading="*res://scenes/ui/loading_screen.tscn"
Net="*res://src/net/network.gd"
Pause="*res://src/ui/pause_menu.gd"
Quests="*res://src/quests/quest_manager.gd"
Contracts="*res://src/quests/contracts.gd"
Chat="*res://src/net/chat.gd"
Trade="*res://src/net/trade.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=40

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

