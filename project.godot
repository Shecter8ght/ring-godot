[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
anti_aliasing/quality/msaa_3d=2
scaling_3d/mode=1
global_illumination/sdfgi/probe_ray_count=2
global_illumination/sdfgi/frames_to_converge=2
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.1, 1)
anti_aliasing/quality/screen_space_aa=2
occlusion_culling/use_occlusion_culling=true

[shader_globals]

rain_wet={
"type": "float",
"value": 0.0
}
fx_time={
