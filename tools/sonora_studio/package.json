{
  "name": "sonora-studio",
  "productName": "Sonora Studio",
  "version": "1.6.0",
  "description": "Локальная аудиомастерская: монтаж, эффекты, варианты звуков и импорт в Ring",
  "main": "src/main.cjs",
  "author": "Sonora Studio",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.cjs",
    "build": "electron-builder --win portable --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never",
    "test:ring": "node tests/ring-v2.cjs",
    "test:composer": "node tests/composer.cjs",
    "test:shot": "node tests/shot.cjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "local.sonora.studio",
    "productName": "Sonora Studio",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "tools/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "vendor/FFmpeg-LICENSE.txt",
        "to": "FFmpeg-LICENSE.txt"
      },
      {
        "from": "vendor/FFmpeg-BUILD-CONFIGURATION.txt",
        "to": "FFmpeg-BUILD-CONFIGURATION.txt"
      },
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "Sonora-Studio-${version}.exe"
    },
    "compression": "normal"
  }
}
