func _on_transfer() -> void:
	var journal := transfer()
	if journal.is_empty():
		_status.text = "Нечего добавлять: назначь файл звуку, прослушай и поставь галочку «Одобрен»."
	else:
		_status.text = "Добавление в проект:\n" + "\n".join(journal) \
			+ "\nВ стенде запись уже доступна через игровой Audio. Перед следующим запуском проекта выполни импорт или открой редактор."


func _apply_bulk_source() -> void:
	var source := _bulk_source.text.strip_edges()
	if source == "":
		_status.text = "Сначала укажи общий источник и лицензию."
		return
	var changed := 0
	for rel in files:
		var picked := sel(rel)
		if String(picked.source).strip_edges() == "":
			picked.source = source
			changed += 1
	save_selection()
	_refresh_details()
	_refresh_new_list()
	_status.text = "Источник заполнен у %d входящих файлов; уже заполненные поля не изменены." % changed


