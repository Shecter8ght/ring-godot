func _apply_bulk_source() -> void:
	var source := _bulk_source.text.strip_edges()
	if source == "":
		_status.text = "Сначала укажи общий источник и лицензию."
		return
	var changed := 0
	for rel in files:
		var picked := sel(rel)
		if String(picked.source).strip_edges() == "":
			picked.source = source
			changed += 1
	save_selection()
	_refresh_details()
	_refresh_new_list()
	_status.text = "Источник заполнен у %d входящих файлов; уже заполненные поля не изменены." % changed


