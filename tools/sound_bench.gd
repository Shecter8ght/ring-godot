func _spin(lo: int, hi: int, v: int) -> SpinBox:
	var s := SpinBox.new()
	s.min_value = lo
	s.max_value = hi
	s.value = v
	return s


func _refresh_all() -> void:
	if _tree == null:
		return
	if _tabs != null and _tabs.get_tab_count() > 1:
		_tabs.set_tab_title(1, "Входящие (%d)" % files.size())
	_refresh_tree()
	_refresh_details()
	_refresh_new_list()


func _status_text(st: Dictionary) -> String:
	var t := "%d зап." % int(st.rec) if int(st.rec) > 0 else ("синтез" if bool(st.synth) else "нет записи")
	if int(st.rec) == 0 and int(st.fallback_rec) > 0:
		t = "общий набор: %d" % int(st.fallback_rec)
	if bool(st.absent):
		t = "в игре нет"
	elif not bool(st.wired):
		t += " · не подключён"
	if int(st.disabled) > 0:
		t += " · выкл. %d" % int(st.disabled)
	if int(st.try) > 0:
		t += " · +%d" % int(st.try)
	return t


func _status_color(st: Dictionary) -> Color:
	if int(st.new) > 0:
		return COL_NEW
	if int(st.rec) > 0:
		return COL_REC
	return COL_SYNTH if bool(st.synth) else COL_NONE


func _passes(e: Dictionary, st: Dictionary, q: String) -> bool:
	if q != "" and not (String(e.name).to_lower().contains(q) or String(e.id).contains(q) or String(e.file).contains(q)):
		return false
	match _filter.selected:
		1:
			return int(st.rec) == 0
		2:
			return int(st.rec) == 0 and bool(st.synth)
		3:
			return not bool(st.wired)
		4:
			return int(st.try) > 0
		5:
			return int(e.prio) == 1
		6:
			return int(st.rec) > 0
		7:
			return bool(st.absent)
	return true


func _refresh_tree() -> void:
	_tree.clear()
	var root := _tree.create_item()
	var q := _search.text.strip_edges().to_lower()
	for c in cats:
		var ci: TreeItem = null
		var total := 0
		var rec := 0
		for e in sounds:
			if String(e.cat) != c:
				continue
			total += 1
			var st := status_of(String(e.id))
			if int(st.rec) > 0:
				rec += 1
			if not _passes(e, st, q):
				continue
			if ci == null:
				ci = _tree.create_item(root)
				ci.set_metadata(0, "cat:" + c)
				for col in 2:
					ci.set_selectable(col, false)
				ci.set_custom_color(0, Color(1.0, 0.86, 0.6))
				ci.collapsed = bool(_catalog_collapsed.get(c, true))
			var it := _tree.create_item(ci)
			it.set_text(0, String(e.name))
			it.set_metadata(0, String(e.id))
			it.set_tooltip_text(0, "%s\n%s" % [String(e.when), String(e.id)])
			it.set_text(1, _status_text(st))
			it.set_custom_color(1, _status_color(st))
			if String(e.id) == _current:
				ci.collapsed = false
				it.select(0)
		if ci:
			var cat_text := "%s — с записями %d из %d" % [c, rec, total]
			ci.set_text(0, cat_text)
			ci.set_tooltip_text(0, cat_text)


